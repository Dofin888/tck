QMainWindow {
background-color: #1e1e1e;
}

QPushButton {
    background-color: #333333;
    color: #eeeeee;
    border: 1px solid #454545;
    border-radius: 5px;
    padding: 7px 14px;
}

QPushButton:hover {
    background-color: #454545;
}

QTableWidget {
    background-color: #252526;
    color: #dddddd;
    gridline-color: #3c3c3c;
    border: 1px solid #3c3c3c;
    border-radius: 5px;
    selection-background-color: #264f78;
    selection-color: white;
}

QHeaderView::section {
    background-color: #333333;
    color: #eeeeee;
    padding: 6px;
    border: 1px solid #454545;
    font-weight: bold;
}

QGroupBox {
    background-color: #252526;
    color: #d4d4d4;
    border: 1px solid #454545;
    border-radius: 6px;
    margin-top: 12px;
    padding: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #bbbbbb;
}

QWidget {
    font-family: "Segoe UI";
    font-size: 10pt;
    color: #dddddd;
}
QLabel {
    color: #bbbbbb;
}
QComboBox {
    min-height: 26px;
}

QPushButton {
    min-height: 28px;
}
QTableWidget {
    font-size: 10pt;
}

